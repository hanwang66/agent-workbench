# Ollama endpoint and model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Generation behavior
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.5
MAX_SESSION_TURNS=6
MAX_SESSIONS=10000
SESSION_TTL_SECONDS=3600
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_BACKEND=chroma
RAG_STORE_PATH=data/rag_store.json
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=translation_rag
RETRIEVAL_MODE=hybrid
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
HYBRID_RRF_K=60
HYBRID_CANDIDATE_MULTIPLIER=4
FUNCTION_CALL_MAX_ROUNDS=4
FUNCTION_CALL_MAX_TOOL_CALLS=4
FUNCTION_CALL_ALLOWED_TOOLS=get_rag_context
CODING_WORKSPACE_ROOT=.
CODING_MAX_ROUNDS=6
CODING_MAX_TOOL_CALLS=12
CODING_MAX_FILE_BYTES=131072
CODING_COMMAND_TIMEOUT_SECONDS=30
CODING_SANDBOX_ENABLED=true
CODING_SANDBOX_IMAGE=agent-workbench-sandbox:py312
CODING_SANDBOX_DOCKER_BINARY=docker
CODING_SANDBOX_CPUS=1.0
CODING_SANDBOX_MEMORY=512m
CODING_SANDBOX_PIDS_LIMIT=128
CODING_SANDBOX_OUTPUT_BYTES=65536
CODING_SANDBOX_TMPFS_SIZE=64m
TASK_STATE_BACKEND=sqlite
TASK_STATE_DB_PATH=data/tasks.sqlite3
MAX_TASK_STATES=10000
MAX_UPLOAD_SIZE_BYTES=2097152
UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.csv,.log

# FastAPI runtime
HOST=127.0.0.1
PORT=8000
